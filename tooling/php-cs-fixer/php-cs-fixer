<?php declare(strict_types=1);

$home = getenv('HOME') ?: '';
$cwd = getcwd() ?: $home;

$candidates = [];
$dir = $cwd;

while ($dir !== '' && $dir !== dirname($dir)) {
    $candidates[] = $dir . '/vendor/bin/php-cs-fixer';
    $dir = dirname($dir);
}

if ($home !== '') {
    $candidates[] = $home . '/.composer/vendor/bin/php-cs-fixer';
    $candidates[] = $home . '/.config/composer/vendor/bin/php-cs-fixer';
}

$tool = null;

foreach ($candidates as $candidate) {
    if (is_file($candidate) && is_readable($candidate)) {
        $tool = $candidate;
        break;
    }
}

if ($tool === null) {
    fwrite(STDERR, "Unable to find php-cs-fixer. Install it in the project or globally with Composer.\n");
    exit(127);
}

$args = array_slice($argv, 1);
$command = array_merge([PHP_BINARY, $tool], $args);

$process = proc_open($command, [
    0 => STDIN,
    1 => STDOUT,
    2 => STDERR,
], $pipes);

if (! is_resource($process)) {
    fwrite(STDERR, "Unable to start php-cs-fixer.\n");
    exit(1);
}

exit(proc_close($process));
